# =============================================================================
# PrimeHomes Real Estate Lead Bot — environment template
# Copy to .env and fill with real values. NEVER commit .env or real secrets.
# All values below are placeholders. Toolchain and providers are pending approval.
# =============================================================================

# --- Application ---
APP_ENV=local
APP_DEBUG=true
LOG_LEVEL=INFO
CORRELATION_HEADER=X-Correlation-ID

# --- Backend (FastAPI) ---
# API_HOST=0.0.0.0
# API_PORT=8000
# PUBLIC_BASE_URL=http://localhost:8000

# --- Database (ADR-0002 still Proposed — do not assume production PostgreSQL yet) ---
# DATABASE_URL=postgresql+asyncpg://primehomes:changeme@localhost:5432/primehomes
# DATABASE_POOL_SIZE=5

# --- Customer session / auth (D-03 undecided) ---
# CUSTOMER_SESSION_SECRET=replace-with-long-random-string
# CUSTOMER_SESSION_TTL_SECONDS=86400
# SALES_AUTH_PROVIDER=undecided
# SALES_OIDC_ISSUER=
# SALES_OIDC_CLIENT_ID=
# SALES_OIDC_CLIENT_SECRET=

# --- Internal service auth (n8n → FastAPI) ---
# INTERNAL_SERVICE_TOKEN=replace-with-service-token

# --- Outbox / worker (D-02 undecided) ---
# OUTBOX_POLL_INTERVAL_MS=1000
# OUTBOX_LEASE_SECONDS=30
# OUTBOX_MAX_ATTEMPTS=8

# --- n8n ---
# N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
# N8N_LEAD_PROCESSING_PATH=/ph-lead-processing

# --- AI provider (D-04 undecided) ---
# AI_PROVIDER=
# AI_API_KEY=
# AI_MODEL=
# AI_PROMPT_VERSION=1.0

# --- Notifications (D-05 undecided) ---
# NOTIFICATION_PROVIDER=
# NOTIFICATION_API_KEY=
# NOTIFICATION_FROM=

# --- Optional Google Sheets export (ADR-0009 Proposed) ---
# SHEETS_ENABLED=false
# SHEETS_SPREADSHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Frontend (public only; no secrets) ---
# VITE_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
